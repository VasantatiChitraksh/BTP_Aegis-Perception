# Data and generated artifacts
data/archives/
data/raw/
data/interim/
data/processed/
data/derived/
artifacts/*
# Publish compact baseline identities; keep all weights and training state ignored.
!artifacts/models/
artifacts/models/*
!artifacts/models/index.json
!artifacts/models/README.txt
!artifacts/models/attention_pix2pix/
!artifacts/models/restormer/
!artifacts/models/liteweatherformer/
!artifacts/models/transweather/
!artifacts/models/promptir/
!artifacts/models/ramit/
artifacts/models/*/*
!artifacts/models/*/config.json
!artifacts/models/*/inference_provenance.json
# Publish only the final six-model report and its results table.
!artifacts/reports/
artifacts/reports/*
!artifacts/reports/six_models_20261024/
artifacts/reports/six_models_20261024/*
!artifacts/reports/six_models_20261024/aegis_six_model_benchmark.pdf
!artifacts/reports/six_models_20261024/aegis_six_model_benchmark.csv
# Publish only the Restormer deployment report, metrics and verification summary.
!artifacts/edge_v1/
artifacts/edge_v1/*
!artifacts/edge_v1/local_verification.json
!artifacts/edge_v1/reports/
artifacts/edge_v1/reports/*
!artifacts/edge_v1/reports/restormer_edge_readiness.pdf
!artifacts/edge_v1/reports/restormer_edge_readiness.json
!artifacts/edge_v1/reports/detection_pilot72.csv
!artifacts/edge_v1/reports/restormer_compression_screen.json
!artifacts/edge_v1/reports/restormer_compression_screen.csv
!artifacts/edge_v1/reports/aegis_jetson_step_by_step.pdf
!artifacts/edge_v1/reports/aegis_jetson_step_by_step.txt
